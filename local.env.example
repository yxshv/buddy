# Copy to local.env (gitignored) and fill in. build.sh bakes these into the app; rebuild after changes.
# Paths may start with ~. Leave a line out to use the default shown.

# Bundle identifier. Keep it stable: macOS ties Buddy's permissions and its Keychain item to it.
BUDDY_BUNDLE_ID=local.buddy
# Code-signing certificate name or SHA-1 (default: the first one named "Buddy" or "Apple Development").
# BUDDY_SIGN_ID=

# Folders for the built-in features. Buddy never edits code in BUDDY_CF or BUDDY_CS.
BUDDY_CF=~/cf
BUDDY_CS=~/cs
BUDDY_PROJECTS=~/Projects

# `buddy obsidian publish`: your publisher project and the site it deploys to.
BUDDY_PUBLISHER=~/vault-public
BUDDY_SITE_URL=https://example.com/
